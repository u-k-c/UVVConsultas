@model IEnumerable<UVVConsultas.Models.Consulta>
@{
    ViewData["Title"] = "Minhas Consultas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Minhas Consultas</h2>
    <a asp-action="Create" class="btn btn-primary">Nova Consulta</a>
</div>

@if (TempData["MensagemSucesso"] is not null)
{
    <div class="alert alert-success">@TempData["MensagemSucesso"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">Você ainda não possui consultas agendadas.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th>Área</th>
                    <th>Tipo</th>
                    <th>Médico</th>
                    <th>Data/Hora</th>
                    <th>Descrição</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Especialidade</td>
                        <td>@item.TipoAtendimento</td>
                        <td>@item.Medico</td>
                        <td>@item.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Descricao</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-2">Editar</a>
                            <form asp-action="Delete" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@item.Id" />
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Deseja excluir esta consulta?');">Excluir</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
