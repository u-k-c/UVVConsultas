@{
    ViewData["Title"] = "Sistema UVV";
}

<div class="home-hero">
    <span class="home-kicker">Sistema UVV</span>
    <h1>Consultas organizadas, cuidado em primeiro lugar.</h1>
    <p class="lead">Gerencie seus agendamentos com clareza, segurança e uma experiência simples de usar.</p>

    <div class="home-actions d-flex justify-content-center gap-3 flex-wrap">
        <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg">Criar conta</a>
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-lg">Fazer login</a>
    </div>
</div>

<div class="home-features">
    <div class="feature-item">
        <strong>Acesso protegido</strong>
        <span>Seus dados ficam disponíveis apenas para sua conta.</span>
    </div>
    <div class="feature-item">
        <strong>Agenda em ordem</strong>
        <span>Veja suas consultas organizadas por data e horário.</span>
    </div>
    <div class="feature-item">
        <strong>Controle completo</strong>
        <span>Cadastre, edite e remova agendamentos quando precisar.</span>
    </div>
</div>
